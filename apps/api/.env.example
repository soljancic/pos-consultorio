DATABASE_URL="postgresql://pos_user:pos_pass@localhost:5432/pos_consultorio"

# En produccion main.ts se niega a arrancar si contienen "change-this"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-this-refresh-secret-too"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3000
NODE_ENV=development

# CORS: dominio del frontend en produccion
FRONTEND_URL="http://localhost:5173"

# false = cierra POST /auth/register (recomendado para el piloto)
REGISTRO_ABIERTO=true

# CRITICO: timezone del consultorio — caja y agenda usan el dia LOCAL del server
TZ=America/La_Paz

# Rate limit de auth (defaults estrictos: login 10/min, register 5/min)
# En dev/test subirlos para que la suite E2E no se bloquee
LOGIN_RATE_LIMIT=1000
REGISTER_RATE_LIMIT=1000
