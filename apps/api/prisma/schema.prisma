generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Rol {
  ADMIN
  SECRETARIA
  DOCTOR
  CAJA
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  LLEGO
  EN_ATENCION
  ATENDIDA
  COBRADO
  CON_DEUDA
  CANCELADA
  NO_ASISTIO
  REPROGRAMADA
}

enum EstadoCobro {
  PENDIENTE
  PARCIAL
  COMPLETO
  ANULADO
}

enum FormaPago {
  EFECTIVO
  QR
  TARJETA
  VALES
}

// Origen de la cita: agenda interna o portal publico de reservas (E2.5b)
enum OrigenCita {
  INTERNO
  PORTAL
}

enum TipoDisponibilidad {
  DISPONIBLE
  VACACIONES
  AUSENCIA
  CAPACITACION
  REUNION
  BLOQUEADO
}

enum CategoriaGasto {
  INSUMOS
  SUELDOS
  ALQUILER
  SERVICIOS
  IMPUESTOS
  OTROS
}

enum CuentaGasto {
  CAJA_EFECTIVO
  BANCO
  OTRO
}

enum AccionLog {
  CREATE
  UPDATE
  DELETE
  STATE_CHANGE
  PAYMENT
}

// ─── TENANCY ─────────────────────────────────────────────────────────────────

model Consultorio {
  id        Int      @id @default(autoincrement())
  nombre    String
  logoUrl   String?
  telefono  String?
  direccion String?
  moneda    String   @default("ARS")
  timezone  String   @default("America/Argentina/Buenos_Aires")
  plan      String   @default("free")
  activo    Boolean  @default(true)
  // Portal publico de reservas (E2.5b): /reservar/:slug
  slug         String?  @unique
  portalActivo Boolean  @default(false)
  // E3 item 26: plantillas de WhatsApp editables; null = default del sistema.
  // Variables: {nombre} {hora} {fecha} {monto} {consultorio}
  msjRecordatorio String?
  msjDeuda        String?
  msjContacto     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios   Usuario[]
  servicios  Servicio[]
  doctores   Doctor[]
  pacientes  Paciente[]
  citas      Cita[]
  cobros     Cobro[]
  cajaDiaria CajaDiaria[]
  gastos     Gasto[]
  disponibilidades Disponibilidad[]
  seriesDisponibilidad SerieDisponibilidad[]
  plantillasHorario PlantillaHorario[]
  mensajesPendientes MensajePendiente[]
  logs       Log[]

  @@map("consultorios")
}

model Usuario {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  nombre        String
  email         String
  passwordHash  String
  rol           Rol
  activo        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  citasCreadas     Cita[]       @relation("CitaCreatedBy")
  pagosRegistrados Pago[]       @relation("PagoCreatedBy")
  pagosAnulados    Pago[]       @relation("PagoAnuladoPor")
  cajasAbiertas    CajaDiaria[] @relation("CajaAbiertaPor")
  cajasCerradas    CajaDiaria[] @relation("CajaCerradaPor")
  cajasRevisadas   CajaDiaria[] @relation("CajaRevisadaPor")
  gastosRegistrados Gasto[]     @relation("GastoRegistradoPor")
  logs             Log[]
  doctor           Doctor?
  passwordTokens   PasswordToken[]
  mensajesResueltos MensajePendiente[] @relation("MensajeResueltoPor")

  @@unique([email, consultorioId])
  @@index([consultorioId])
  @@map("usuarios")
}

// E2-M10: tokens de un solo uso para definir/restablecer contrasena.
// Se guarda el hash SHA-256 del token, nunca el token plano.
model PasswordToken {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  tokenHash String   @unique
  expiraAt  DateTime
  usadoAt   DateTime?
  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@map("password_tokens")
}

// ─── CATALOGO ────────────────────────────────────────────────────────────────

model Servicio {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  nombre        String
  descripcion   String?
  duracionMin   Int
  precioBase    Decimal     @db.Decimal(10, 2)
  activo        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  citas Cita[]
  doctores Doctor[] @relation("DoctorServicios")

  @@index([consultorioId])
  @@map("servicios")
}

model Doctor {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  usuarioId     Int?     @unique
  usuario       Usuario?    @relation(fields: [usuarioId], references: [id])
  nombre        String
  especialidad  String?
  // E4 item 21: % de comision sobre los pagos netos de sus citas
  // (null = sin comision configurada; la liquidacion vive en /reportes)
  comisionPct   Decimal?    @db.Decimal(5, 2)
  colorAgenda   String      @default("#3B82F6")
  activo        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  horarios HorarioAtencion[]
  citas    Cita[]
  disponibilidades Disponibilidad[]
  seriesDisponibilidad SerieDisponibilidad[]
  // Calendario f2: servicios que atiende. Lista vacia = atiende todos
  // (compatibilidad con doctores existentes)
  servicios Servicio[] @relation("DoctorServicios")

  @@index([consultorioId])
  @@map("doctores")
}

model HorarioAtencion {
  id         Int      @id @default(autoincrement())
  doctorId   Int
  doctor     Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  diaSemana  Int     // 0=domingo ... 6=sabado
  horaInicio String  // "08:00"
  horaFin    String  // "18:00"
  activo     Boolean @default(true)

  @@index([doctorId])
  @@map("horarios_atencion")
}

// ─── PACIENTES ───────────────────────────────────────────────────────────────

model Paciente {
  id              Int      @id @default(autoincrement())
  consultorioId   Int
  consultorio     Consultorio @relation(fields: [consultorioId], references: [id])
  nombre          String
  apellido        String
  dni             String?
  telefono        String?
  // ISO 3166-1 alfa-2; define el prefijo internacional para wa.me
  pais            String      @default("BO")
  // Token opaco para links de reserva precargados (/reservar/:slug?p=token):
  // aleatorio e impredecible, se genera al armar el primer link del paciente
  portalToken     String?     @unique
  email           String?
  fechaNacimiento DateTime?   @db.Date
  sexo            String?     // "M" | "F" | "X"
  direccion       String?
  notas           String?
  deudaTotal      Decimal     @default(0) @db.Decimal(10, 2)
  // E3 item 11: pacientes con historial de no-shows pueden exigir prepago.
  // ALERTA al agendar, no bloquea (regla del proyecto: deudas alertan)
  requierePrepago Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  citas Cita[]
  mensajesPendientes MensajePendiente[]

  @@index([consultorioId, apellido, nombre])
  @@index([consultorioId, dni])
  // el portal publico matchea pacientes por telefono
  @@index([consultorioId, telefono])
  @@map("pacientes")
}

// ─── AGENDA ──────────────────────────────────────────────────────────────────

model Cita {
  id              Int      @id @default(autoincrement())
  consultorioId   Int
  consultorio     Consultorio @relation(fields: [consultorioId], references: [id])
  pacienteId      Int
  paciente        Paciente    @relation(fields: [pacienteId], references: [id])
  doctorId        Int
  doctor          Doctor      @relation(fields: [doctorId], references: [id])
  servicioId      Int
  servicio        Servicio    @relation(fields: [servicioId], references: [id])
  fechaHora       DateTime
  duracionMin     Int
  estado          EstadoCita  @default(PENDIENTE)
  origen          OrigenCita  @default(INTERNO)
  notasSecretaria String?
  createdById     Int
  createdBy       Usuario     @relation("CitaCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  atencion Atencion?
  mensajesPendientes MensajePendiente[]
  cobro    Cobro?

  @@index([consultorioId, fechaHora])
  @@index([consultorioId, doctorId, fechaHora])
  @@index([consultorioId, pacienteId])
  @@index([consultorioId, estado])
  @@map("citas")
}

// ─── CLINICO ─────────────────────────────────────────────────────────────────

model Atencion {
  id             Int      @id @default(autoincrement())
  citaId         Int    @unique
  cita           Cita      @relation(fields: [citaId], references: [id])
  motivo         String?
  diagnostico    String?
  tratamiento    String?
  evolucion      String?
  proximoControl DateTime? @db.Date
  adjuntos       Json?     // [{ url, nombre, tipo, tamano }]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  recetas Receta[]

  @@map("atenciones")
}

model Receta {
  id         Int      @id @default(autoincrement())
  atencionId Int
  atencion   Atencion @relation(fields: [atencionId], references: [id])
  contenido  Json     // { medicamentos: [...], indicaciones: string }
  pdfUrl     String?
  createdAt  DateTime @default(now())

  @@map("recetas")
}

// ─── FINANCIERO ──────────────────────────────────────────────────────────────

model Cobro {
  id             Int      @id @default(autoincrement())
  citaId         Int      @unique
  cita           Cita        @relation(fields: [citaId], references: [id])
  consultorioId  Int
  consultorio    Consultorio @relation(fields: [consultorioId], references: [id])
  total          Decimal     @db.Decimal(10, 2)
  saldoPendiente Decimal     @db.Decimal(10, 2)
  estado         EstadoCobro @default(PENDIENTE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  pagos Pago[]

  @@index([consultorioId])
  @@index([consultorioId, estado])
  @@map("cobros")
}

model Pago {
  id          Int      @id @default(autoincrement())
  cobroId     Int
  cobro       Cobro     @relation(fields: [cobroId], references: [id])
  formaPago   FormaPago
  monto       Decimal   @db.Decimal(10, 2)
  referencia  String?
  createdById Int
  createdBy   Usuario   @relation("PagoCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  // Anulacion con asiento de reversa (E2-M1): el original nunca se borra
  anuladoAt       DateTime?
  anuladoPorId    Int?
  anuladoPor      Usuario?  @relation("PagoAnuladoPor", fields: [anuladoPorId], references: [id])
  motivoAnulacion String?
  reversaDeId     Int?      @unique
  reversaDe       Pago?     @relation("PagoReversa", fields: [reversaDeId], references: [id])
  reversa         Pago?     @relation("PagoReversa")

  @@index([cobroId])
  @@map("pagos")
}

model CajaDiaria {
  id                Int      @id @default(autoincrement())
  consultorioId     Int
  consultorio       Consultorio @relation(fields: [consultorioId], references: [id])
  fecha             DateTime    @db.Date
  usuarioAperturaId Int
  usuarioApertura   Usuario     @relation("CajaAbiertaPor", fields: [usuarioAperturaId], references: [id])
  usuarioCierreId   Int?
  usuarioCierre     Usuario?    @relation("CajaCerradaPor", fields: [usuarioCierreId], references: [id])
  totalEfectivo     Decimal     @default(0) @db.Decimal(10, 2)
  totalQr           Decimal     @default(0) @db.Decimal(10, 2)
  totalVales        Decimal     @default(0) @db.Decimal(10, 2)
  totalTarjeta      Decimal     @default(0) @db.Decimal(10, 2)
  totalGeneral      Decimal     @default(0) @db.Decimal(10, 2)
  cerrada           Boolean     @default(false)
  cierreAt          DateTime?
  createdAt         DateTime    @default(now())

  // Apertura de turno (E2-M9): la jornada arranca declarando la caja chica;
  // sin caja abierta no se cobra ni se registra gastos
  montoInicial   Decimal   @default(0) @db.Decimal(10, 2)
  abiertaAt      DateTime?
  notasApertura  String?

  // Arqueo ciego (E2-M2): declarado vs esperado, solo efectivo
  montoDeclarado Decimal?  @db.Decimal(10, 2)
  montoEsperado  Decimal?  @db.Decimal(10, 2)
  diferencia     Decimal?  @db.Decimal(10, 2)
  notasCierre    String?
  revisadaPorId  Int?
  revisadaPor    Usuario?  @relation("CajaRevisadaPor", fields: [revisadaPorId], references: [id])
  revisadaAt     DateTime?
  notasRevision  String?

  @@unique([consultorioId, fecha])
  @@index([consultorioId])
  @@map("caja_diaria")
}

// ─── CALENDARIO DE ATENCION (E2.5a) ──────────────────────────────────────────
// Horarios reales del doctor. Las series materializan sus ocurrencias hasta
// la fecha limite (simplifica solapes, excepciones y "editar desde aca").
// Reemplaza al modelo simple HorarioAtencion (que queda legacy).

model SerieDisponibilidad {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  doctorId      Int
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  diasSemana    Int[]    // 0=domingo .. 6=sabado (Date.getDay)
  desde         DateTime @db.Date
  hasta         DateTime @db.Date
  horaInicio    String   // "HH:mm"
  horaFin       String
  tipo          TipoDisponibilidad @default(DISPONIBLE)
  nota          String?
  createdAt     DateTime @default(now())

  ocurrencias Disponibilidad[]

  @@index([consultorioId, doctorId])
  @@map("series_disponibilidad")
}

model Disponibilidad {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  doctorId      Int
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  fecha         DateTime @db.Date
  horaInicio    String   // "HH:mm" — comparable lexicograficamente
  horaFin       String
  tipo          TipoDisponibilidad @default(DISPONIBLE)
  nota          String?
  serieId       Int?
  serie         SerieDisponibilidad? @relation(fields: [serieId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([consultorioId, fecha])
  @@index([consultorioId, doctorId, fecha])
  @@map("disponibilidades")
}

// Calendario f2b: presets de horario nombrados por consultorio, reutilizables
// al crear bloques de disponibilidad ("Manana corta 8-12", etc.)
model PlantillaHorario {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  nombre        String
  horaInicio    String   // "HH:mm"
  horaFin       String
  createdAt     DateTime @default(now())
  deletedAt     DateTime?

  @@index([consultorioId])
  @@map("plantillas_horario")
}

// E3 item 41a: cola de mensajes pendientes (canal manual asistido).
// El sistema encola recordatorios/deudas; el staff abre wa.me y marca el
// resultado. La Business API queda para cuando el owner lo decida.
enum TipoMensaje {
  RECORDATORIO
  DEUDA
}

enum EstadoMensaje {
  PENDIENTE
  ENVIADO
  OMITIDO
}

model MensajePendiente {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  pacienteId    Int
  paciente      Paciente    @relation(fields: [pacienteId], references: [id])
  citaId        Int?
  cita          Cita?       @relation(fields: [citaId], references: [id])
  tipo          TipoMensaje
  estado        EstadoMensaje @default(PENDIENTE)
  detalle       String?   // texto de apoyo: hora de la cita o monto adeudado
  creadoAt      DateTime  @default(now())
  resueltoAt    DateTime?
  resueltoPorId Int?
  resueltoPor   Usuario?  @relation("MensajeResueltoPor", fields: [resueltoPorId], references: [id])

  @@unique([citaId, tipo])
  @@index([consultorioId, estado])
  @@map("mensajes_pendientes")
}

// Gastos administrativos (E2-M8): egresos con categoria y cuenta de origen.
// Solo CAJA_EFECTIVO participa del arqueo; la caja diaria NO se reescribe
// (los egresos se computan dinamicamente en /caja/hoy y al cerrar).
model Gasto {
  id              Int      @id @default(autoincrement())
  consultorioId   Int
  consultorio     Consultorio @relation(fields: [consultorioId], references: [id])
  fecha           DateTime    @db.Date
  categoria       CategoriaGasto
  monto           Decimal     @db.Decimal(10, 2)
  descripcion     String
  personal        String?     // a quien se pago (texto libre)
  cuenta          CuentaGasto @default(CAJA_EFECTIVO)
  comprobanteUrl  String?
  registradoPorId Int
  registradoPor   Usuario     @relation("GastoRegistradoPor", fields: [registradoPorId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  @@index([consultorioId, fecha])
  @@map("gastos")
}

// ─── AUDITORIA ───────────────────────────────────────────────────────────────

model Log {
  id             Int      @id @default(autoincrement())
  consultorioId  Int
  consultorio    Consultorio @relation(fields: [consultorioId], references: [id])
  usuarioId      Int?
  usuario        Usuario?    @relation(fields: [usuarioId], references: [id])
  entidad        String      // "Cita" | "Cobro" | "Pago" | "Paciente"
  entidadId      Int
  accion         AccionLog
  payloadAntes   Json?
  payloadDespues Json?
  ip             String?
  createdAt      DateTime    @default(now())

  @@index([consultorioId, entidad, entidadId])
  @@index([consultorioId, createdAt])
  @@map("logs")
}
