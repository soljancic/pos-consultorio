generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: la url ya no va en el schema. Para el CLI/Migrate vive en
  // prisma.config.ts; en runtime el PrismaClient recibe el adapter (@prisma/adapter-pg).
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Rol {
  ADMIN
  SECRETARIA
  DOCTOR
  CAJA
}

enum EstadoCita {
  SOLICITADA
  PENDIENTE
  CONFIRMADA
  LLEGO
  EN_ATENCION
  ATENDIDA
  COBRADO
  CON_DEUDA
  CANCELADA
  NO_ASISTIO
  REPROGRAMADA
}

enum EstadoCobro {
  PENDIENTE
  PARCIAL
  COMPLETO
  ANULADO
}

// Origen de la cita: agenda interna o portal publico de reservas (E2.5b)
enum OrigenCita {
  INTERNO
  PORTAL
}

enum TipoDisponibilidad {
  DISPONIBLE
  VACACIONES
  AUSENCIA
  CAPACITACION
  REUNION
  BLOQUEADO
}

enum AccionLog {
  CREATE
  UPDATE
  DELETE
  STATE_CHANGE
  PAYMENT
}

// ─── TENANCY ─────────────────────────────────────────────────────────────────

model Consultorio {
  id        Int      @id @default(autoincrement())
  nombre    String
  logoUrl   String?
  telefono  String?
  direccion String?
  // Link de Google Maps del consultorio (lo pega el admin); va en el boton
  // "Ver ubicacion" del email y en el WhatsApp de la cita
  ubicacionUrl String?
  // Pais del consultorio (ISO alfa-2): prefijo internacional del WhatsApp propio
  pais      String?
  moneda    String   @default("ARS")
  timezone  String   @default("America/Argentina/Buenos_Aires")
  plan      String   @default("free")
  activo    Boolean  @default(true)
  // Portal publico de reservas (E2.5b): /reservar/:slug
  slug         String?  @unique
  portalActivo Boolean  @default(false)
  // E3 item 26: plantillas de WhatsApp editables; null = default del sistema.
  // Variables: {nombre} {hora} {fecha} {monto} {consultorio}
  msjRecordatorio String?
  msjDeuda        String?
  msjContacto     String?
  // QR de pagos del consultorio (Cloudinary); lo ve el paciente en /qr/:slug
  qrUrl           String?
  // Email al que se envia el resumen de cada cierre de caja (opcional)
  emailCierreCaja String?
  // Modulo Aseguradoras (F1): habilita catalogo, cobertura en cita y liquidaciones.
  // Default off: la mayoria de los consultorios no usa el modulo.
  trabajaConAseguradoras Boolean @default(false)
  // Modulo Productos e Inventario (P1): habilita catalogo de productos, venta
  // mixta en el cobro y venta directa. Default off: la mayoria no vende nada.
  vendeProductos Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios   Usuario[]
  servicios  Servicio[]
  doctores   Doctor[]
  pacientes  Paciente[]
  citas      Cita[]
  cobros     Cobro[]
  cajaDiaria CajaDiaria[]
  gastos     Gasto[]
  tiposGasto  TipoGasto[]
  tiposCuenta TipoCuenta[]
  aseguradoras     Aseguradora[]
  categoriasSeguro CategoriaSeguro[]
  tarifasCobertura TarifaCobertura[]
  liquidaciones    LiquidacionItem[]
  productos        Producto[]
  detalleCobros    DetalleCobro[]
  disponibilidades Disponibilidad[]
  seriesDisponibilidad SerieDisponibilidad[]
  plantillasHorario PlantillaHorario[]
  mensajesPendientes MensajePendiente[]
  logs       Log[]
  notificaciones Notificacion[]

  @@map("consultorios")
}

model Usuario {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  nombre        String
  email         String
  passwordHash  String
  rol           Rol
  activo        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  citasCreadas     Cita[]       @relation("CitaCreatedBy")
  pagosRegistrados Pago[]       @relation("PagoCreatedBy")
  pagosAnulados    Pago[]       @relation("PagoAnuladoPor")
  cajasAbiertas    CajaDiaria[] @relation("CajaAbiertaPor")
  cajasCerradas    CajaDiaria[] @relation("CajaCerradaPor")
  cajasRevisadas   CajaDiaria[] @relation("CajaRevisadaPor")
  gastosRegistrados Gasto[]     @relation("GastoRegistradoPor")
  detallesDevueltos DetalleCobro[] @relation("DetalleDevueltoPor")
  detallesCreados   DetalleCobro[] @relation("DetalleCreadoPor")
  logs             Log[]
  doctor           Doctor?
  passwordTokens   PasswordToken[]
  sessions         Session[]
  mensajesResueltos MensajePendiente[] @relation("MensajeResueltoPor")
  notificaciones Notificacion[]

  @@unique([email, consultorioId])
  @@index([consultorioId])
  @@map("usuarios")
}

// Sesiones de refresh con rotacion + deteccion de reuso (hardening auth 2026-06-21).
// Se guarda SOLO el hash SHA-256 del refresh token vigente, nunca el token plano
// (mismo patron que PasswordToken). Cada refresh rota el eslabon: el anterior queda
// revocado. Un refresh ya revocado que se vuelve a presentar = senal de robo: se
// revoca toda la familia. logout y cambio de contrasena revocan en el server.
model Session {
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  // uuid de la cadena de rotacion: todos los eslabones comparten familia
  familia    String
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  expiraAt   DateTime
  revocadoAt DateTime?
  createdAt  DateTime @default(now())

  @@index([usuarioId])
  @@index([familia])
  @@map("sessions")
}

// E2-M10: tokens de un solo uso para definir/restablecer contrasena.
// Se guarda el hash SHA-256 del token, nunca el token plano.
model PasswordToken {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  tokenHash String   @unique
  expiraAt  DateTime
  usadoAt   DateTime?
  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@map("password_tokens")
}

// ─── CATALOGO ────────────────────────────────────────────────────────────────

model Servicio {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  nombre        String
  descripcion   String?
  duracionMin   Int
  precioBase    Decimal     @db.Decimal(10, 2)
  activo        Boolean     @default(true)
  // El servicio aparece en el dropdown del portal publico. false = oculto
  // (solo reservable por deep-link &servicio=). No bloquea la reserva.
  mostrarEnBooking  Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  citas Cita[]
  doctores Doctor[] @relation("DoctorServicios")
  preciosDoctor DoctorServicioPrecio[]
  tarifasCobertura TarifaCobertura[]
  liquidaciones LiquidacionItem[]
  detalleCobros DetalleCobro[]

  @@index([consultorioId])
  @@map("servicios")
}

model Doctor {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  usuarioId     Int?     @unique
  usuario       Usuario?    @relation(fields: [usuarioId], references: [id])
  nombre        String
  especialidad  String?
  // E4 item 21: % de comision sobre los pagos netos de sus citas
  // (null = sin comision configurada; la liquidacion vive en /reportes)
  comisionPct   Decimal?    @db.Decimal(5, 2)
  colorAgenda   String      @default("#3B82F6")
  // Foto del doctor (Cloudinary); si no tiene, la agenda usa el circulo de color
  fotoUrl       String?
  activo        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  citas    Cita[]
  disponibilidades Disponibilidad[]
  seriesDisponibilidad SerieDisponibilidad[]
  // Calendario f2: servicios que atiende. Lista vacia = atiende todos
  // (compatibilidad con doctores existentes)
  servicios Servicio[] @relation("DoctorServicios")
  // Precio por servicio especifico de este doctor (override del precioBase)
  preciosServicio DoctorServicioPrecio[]

  @@index([consultorioId])
  @@map("doctores")
}

// Precio que cobra un doctor por un servicio puntual. Si no hay fila, la cita
// usa el precioBase del servicio; si la hay, al crear la cita el cobro toma
// este precio (override). Tabla aditiva: la membresia doctor-servicio sigue
// viviendo en el M2M DoctorServicios.
model DoctorServicioPrecio {
  id         Int      @id @default(autoincrement())
  doctorId   Int
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  servicioId Int
  servicio   Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  precio     Decimal  @db.Decimal(10, 2)

  @@unique([doctorId, servicioId])
  @@index([doctorId])
  @@map("doctor_servicio_precios")
}

// ─── PACIENTES ───────────────────────────────────────────────────────────────

model Paciente {
  id              Int      @id @default(autoincrement())
  consultorioId   Int
  consultorio     Consultorio @relation(fields: [consultorioId], references: [id])
  nombre          String
  apellido        String
  dni             String?
  telefono        String?
  // ISO 3166-1 alfa-2; define el prefijo internacional para wa.me
  pais            String      @default("BO")
  // Token opaco para links de reserva precargados (/reservar/:slug?p=token):
  // aleatorio e impredecible, se genera al armar el primer link del paciente
  portalToken     String?     @unique
  email           String?
  fechaNacimiento DateTime?   @db.Date
  sexo            String?     // "M" | "F" | "X"
  direccion       String?
  notas           String?
  deudaTotal      Decimal     @default(0) @db.Decimal(10, 2)
  // E3 item 11: pacientes con historial de no-shows pueden exigir prepago.
  // ALERTA al agendar, no bloquea (regla del proyecto: deudas alertan)
  requierePrepago Boolean     @default(false)
  // Seguro del paciente (opcional). El paciente puede tener seguro y aun asi
  // atenderse particular: la decision real se toma por cita.
  tieneSeguro       Boolean @default(false)
  aseguradoraId     Int?
  aseguradora       Aseguradora?     @relation(fields: [aseguradoraId], references: [id])
  categoriaSeguroId Int?
  categoriaSeguro   CategoriaSeguro? @relation(fields: [categoriaSeguroId], references: [id])
  codigoSeguro      String?
  // Archivar (activo:false): el paciente se mantiene y se puede ver/reactivar,
  // pero sale del grid por defecto (se mudo, limpiar la base). Distinto de
  // deletedAt (borrado real, no expuesto en la UI).
  activo          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  citas Cita[]
  cobros Cobro[]
  mensajesPendientes MensajePendiente[]
  liquidaciones LiquidacionItem[]

  @@index([consultorioId, apellido, nombre])
  @@index([consultorioId, dni])
  // el portal publico matchea pacientes por telefono
  @@index([consultorioId, telefono])
  // FK de cobertura (claude-db M11): pacientes por aseguradora
  @@index([consultorioId, aseguradoraId])
  @@map("pacientes")
}

// ─── AGENDA ──────────────────────────────────────────────────────────────────

model Cita {
  id              Int      @id @default(autoincrement())
  consultorioId   Int
  consultorio     Consultorio @relation(fields: [consultorioId], references: [id])
  pacienteId      Int
  paciente        Paciente    @relation(fields: [pacienteId], references: [id])
  doctorId        Int
  doctor          Doctor      @relation(fields: [doctorId], references: [id])
  servicioId      Int
  servicio        Servicio    @relation(fields: [servicioId], references: [id])
  fechaHora       DateTime
  duracionMin     Int
  estado          EstadoCita  @default(PENDIENTE)
  origen          OrigenCita  @default(INTERNO)
  notasSecretaria String?
  createdById     Int
  createdBy       Usuario     @relation("CitaCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  // Token opaco para el link de auto-reprogramacion del paciente
  // (capability URL: /reservar/:slug?reprogramar=token). Aleatorio e
  // impredecible, se genera la primera vez que se pide el link.
  portalToken     String?     @unique
  // Snapshot inmutable de la cobertura usada en ESTA atencion (no cambia si el
  // paciente cambia de seguro despues). usaSeguro=false => atencion particular.
  usaSeguro         Boolean @default(false)
  categoriaSeguroId Int?
  categoriaSeguro   CategoriaSeguro? @relation(fields: [categoriaSeguroId], references: [id])
  montoPaciente     Decimal? @db.Decimal(10, 2)
  montoAseguradora  Decimal? @db.Decimal(10, 2)
  codigoSeguro      String?

  atencion Atencion?
  mensajesPendientes MensajePendiente[]
  cobro    Cobro?
  notificaciones Notificacion[]
  liquidacion LiquidacionItem?

  @@index([consultorioId, fechaHora])
  @@index([consultorioId, doctorId, fechaHora])
  @@index([consultorioId, pacienteId])
  @@index([consultorioId, estado])
  // FK de cobertura (claude-db M11): reportes de demanda por servicio
  @@index([consultorioId, servicioId])
  @@map("citas")
}

// ─── CLINICO ─────────────────────────────────────────────────────────────────

model Atencion {
  id             Int      @id @default(autoincrement())
  citaId         Int    @unique
  cita           Cita      @relation(fields: [citaId], references: [id])
  motivo         String?
  diagnostico    String?
  tratamiento    String?
  evolucion      String?
  proximoControl DateTime? @db.Date
  adjuntos       Json?     // [{ url, nombre, tipo, tamano }]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  recetas Receta[]

  @@map("atenciones")
}

model Receta {
  id         Int      @id @default(autoincrement())
  atencionId Int
  atencion   Atencion @relation(fields: [atencionId], references: [id])
  contenido  Json     // { medicamentos: [...], indicaciones: string }
  pdfUrl     String?
  createdAt  DateTime @default(now())

  // FK de cobertura (claude-db M11): recetas por atencion
  @@index([atencionId])
  @@map("recetas")
}

// ─── FINANCIERO ──────────────────────────────────────────────────────────────

model Cobro {
  id             Int      @id @default(autoincrement())
  // Desacople P1: nullable para venta directa (sin cita). Sigue @unique:
  // Postgres permite varios NULL (varias ventas directas) y mantiene 1 cobro
  // por cita.
  citaId         Int?     @unique
  cita           Cita?       @relation(fields: [citaId], references: [id])
  // Venta directa cuelga la deuda aca; en el cobro de una cita se copia del
  // paciente de la cita.
  pacienteId     Int?
  paciente       Paciente?   @relation(fields: [pacienteId], references: [id])
  consultorioId  Int
  consultorio    Consultorio @relation(fields: [consultorioId], references: [id])
  total          Decimal     @db.Decimal(10, 2)
  saldoPendiente Decimal     @db.Decimal(10, 2)
  // Descuento sobre el bruto (SUM de detalles). Regla: total = SUM(detalles) - descuento.
  descuento       Decimal    @db.Decimal(10, 2) @default(0)
  motivoDescuento String?
  estado         EstadoCobro @default(PENDIENTE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  pagos    Pago[]
  detalles DetalleCobro[]

  @@index([consultorioId])
  @@index([consultorioId, estado])
  @@index([consultorioId, pacienteId])
  @@map("cobros")
}

model Pago {
  id          Int      @id @default(autoincrement())
  cobroId     Int
  cobro       Cobro     @relation(fields: [cobroId], references: [id])
  // Forma de pago = cuenta del catalogo (unificado con los gastos). esEfectivo
  // de la cuenta define si participa del arqueo de efectivo.
  tipoCuentaId Int
  tipoCuenta   TipoCuenta @relation(fields: [tipoCuentaId], references: [id])
  monto       Decimal   @db.Decimal(10, 2)
  referencia  String?
  createdById Int
  createdBy   Usuario   @relation("PagoCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  // Anulacion con asiento de reversa (E2-M1): el original nunca se borra
  anuladoAt       DateTime?
  anuladoPorId    Int?
  anuladoPor      Usuario?  @relation("PagoAnuladoPor", fields: [anuladoPorId], references: [id])
  motivoAnulacion String?
  reversaDeId     Int?      @unique
  reversaDe       Pago?     @relation("PagoReversa", fields: [reversaDeId], references: [id])
  reversa         Pago?     @relation("PagoReversa")

  @@index([cobroId])
  @@index([tipoCuentaId])
  @@map("pagos")
}

model CajaDiaria {
  id                Int      @id @default(autoincrement())
  consultorioId     Int
  consultorio       Consultorio @relation(fields: [consultorioId], references: [id])
  fecha             DateTime    @db.Date
  usuarioAperturaId Int
  usuarioApertura   Usuario     @relation("CajaAbiertaPor", fields: [usuarioAperturaId], references: [id])
  usuarioCierreId   Int?
  usuarioCierre     Usuario?    @relation("CajaCerradaPor", fields: [usuarioCierreId], references: [id])
  // Solo se persisten efectivo (para el arqueo) y general; el desglose por
  // cuenta se calcula dinamicamente desde los pagos del dia
  totalEfectivo     Decimal     @default(0) @db.Decimal(10, 2)
  totalGeneral      Decimal     @default(0) @db.Decimal(10, 2)
  cerrada           Boolean     @default(false)
  cierreAt          DateTime?
  createdAt         DateTime    @default(now())

  // Apertura de turno (E2-M9): la jornada arranca declarando la caja chica;
  // sin caja abierta no se cobra ni se registra gastos
  montoInicial   Decimal   @default(0) @db.Decimal(10, 2)
  abiertaAt      DateTime?
  notasApertura  String?

  // Arqueo ciego (E2-M2): declarado vs esperado, solo efectivo
  montoDeclarado Decimal?  @db.Decimal(10, 2)
  montoEsperado  Decimal?  @db.Decimal(10, 2)
  diferencia     Decimal?  @db.Decimal(10, 2)
  notasCierre    String?
  revisadaPorId  Int?
  revisadaPor    Usuario?  @relation("CajaRevisadaPor", fields: [revisadaPorId], references: [id])
  revisadaAt     DateTime?
  notasRevision  String?

  @@unique([consultorioId, fecha])
  @@index([consultorioId])
  @@map("caja_diaria")
}

// ─── CALENDARIO DE ATENCION (E2.5a) ──────────────────────────────────────────
// Horarios reales del doctor. Las series materializan sus ocurrencias hasta
// la fecha limite (simplifica solapes, excepciones y "editar desde aca").

model SerieDisponibilidad {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  doctorId      Int
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  diasSemana    Int[]    // 0=domingo .. 6=sabado (Date.getDay)
  desde         DateTime @db.Date
  hasta         DateTime @db.Date
  horaInicio    String   // "HH:mm"
  horaFin       String
  tipo          TipoDisponibilidad @default(DISPONIBLE)
  nota          String?
  createdAt     DateTime @default(now())

  ocurrencias Disponibilidad[]

  @@index([consultorioId, doctorId])
  @@map("series_disponibilidad")
}

model Disponibilidad {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  doctorId      Int
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  fecha         DateTime @db.Date
  horaInicio    String   // "HH:mm" — comparable lexicograficamente
  horaFin       String
  tipo          TipoDisponibilidad @default(DISPONIBLE)
  nota          String?
  serieId       Int?
  serie         SerieDisponibilidad? @relation(fields: [serieId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([consultorioId, fecha])
  @@index([consultorioId, doctorId, fecha])
  @@map("disponibilidades")
}

// Calendario f2b: presets de horario nombrados por consultorio, reutilizables
// al crear bloques de disponibilidad ("Manana corta 8-12", etc.)
model PlantillaHorario {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  nombre        String
  horaInicio    String   // "HH:mm"
  horaFin       String
  createdAt     DateTime @default(now())
  deletedAt     DateTime?

  @@index([consultorioId])
  @@map("plantillas_horario")
}

// E3 item 41a: cola de mensajes pendientes (canal manual asistido).
// El sistema encola recordatorios/deudas; el staff abre wa.me y marca el
// resultado. La Business API queda para cuando el owner lo decida.
enum TipoMensaje {
  RECORDATORIO
  DEUDA
}

enum EstadoMensaje {
  PENDIENTE
  ENVIADO
  OMITIDO
}

model MensajePendiente {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  pacienteId    Int
  paciente      Paciente    @relation(fields: [pacienteId], references: [id])
  citaId        Int?
  cita          Cita?       @relation(fields: [citaId], references: [id])
  tipo          TipoMensaje
  estado        EstadoMensaje @default(PENDIENTE)
  detalle       String?   // texto de apoyo: hora de la cita o monto adeudado
  creadoAt      DateTime  @default(now())
  resueltoAt    DateTime?
  resueltoPorId Int?
  resueltoPor   Usuario?  @relation("MensajeResueltoPor", fields: [resueltoPorId], references: [id])

  @@unique([citaId, tipo])
  @@index([consultorioId, estado])
  @@map("mensajes_pendientes")
}

// Catalogos por consultorio (reemplazan los enums CategoriaGasto/CuentaGasto).
// TipoCuenta es generico (sirve a gastos y a futuro a cobros); esEfectivo marca
// la cuenta que participa del arqueo de caja (0 o 1 por consultorio).
model TipoGasto {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  nombre        String
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  gastos Gasto[]

  @@index([consultorioId])
  @@map("tipos_gasto")
}

model TipoCuenta {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  nombre        String
  activo        Boolean  @default(true)
  esEfectivo    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  gastos Gasto[]
  pagos  Pago[]

  @@index([consultorioId])
  @@map("tipos_cuenta")
}

// Gastos administrativos (E2-M8): egresos con tipo y cuenta de origen.
// Solo la cuenta con esEfectivo participa del arqueo; la caja diaria NO se
// reescribe (los egresos se computan dinamicamente en /caja/hoy y al cerrar).
model Gasto {
  id              Int      @id @default(autoincrement())
  consultorioId   Int
  consultorio     Consultorio @relation(fields: [consultorioId], references: [id])
  fecha           DateTime    @db.Date
  tipoGastoId     Int
  tipoGasto       TipoGasto   @relation(fields: [tipoGastoId], references: [id])
  monto           Decimal     @db.Decimal(10, 2)
  descripcion     String
  personal        String?     // a quien se pago (texto libre)
  tipoCuentaId    Int
  tipoCuenta      TipoCuenta  @relation(fields: [tipoCuentaId], references: [id])
  comprobanteUrl  String?
  registradoPorId Int
  registradoPor   Usuario     @relation("GastoRegistradoPor", fields: [registradoPorId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  @@index([consultorioId, fecha])
  // FK de cobertura (claude-db M11): reportes de gastos por tipo y por cuenta
  @@index([consultorioId, tipoGastoId])
  @@index([consultorioId, tipoCuentaId])
  @@map("gastos")
}

// ─── AUDITORIA ───────────────────────────────────────────────────────────────

model Log {
  id             Int      @id @default(autoincrement())
  consultorioId  Int
  consultorio    Consultorio @relation(fields: [consultorioId], references: [id])
  usuarioId      Int?
  usuario        Usuario?    @relation(fields: [usuarioId], references: [id])
  entidad        String      // "Cita" | "Cobro" | "Pago" | "Paciente"
  entidadId      Int
  accion         AccionLog
  payloadAntes   Json?
  payloadDespues Json?
  ip             String?
  createdAt      DateTime    @default(now())

  @@index([consultorioId, entidad, entidadId])
  @@index([consultorioId, createdAt])
  @@map("logs")
}

// ─── NOTIFICACIONES ──────────────────────────────────────────────────────────

enum TipoNotificacion {
  NUEVA_CITA
  CITA_CANCELADA
  CITA_REPROGRAMADA
  PACIENTE_EN_ESPERA
}

// Centro de notificaciones (in-app). Una fila por evento:
// destinoUsuarioId = null  -> bandeja admin compartida (estado leido global)
// destinoUsuarioId seteado -> fila propia de ese doctor (su Usuario.id)
// Efimeras: borrado real (sin deletedAt); el cron purga las leidas > 7 dias.
model Notificacion {
  id               Int       @id @default(autoincrement())
  consultorioId    Int
  consultorio      Consultorio @relation(fields: [consultorioId], references: [id])
  tipo             TipoNotificacion
  titulo           String
  mensaje          String
  citaId           Int?
  cita             Cita?     @relation(fields: [citaId], references: [id])
  destinoUsuarioId Int?
  destinoUsuario   Usuario?  @relation(fields: [destinoUsuarioId], references: [id])
  leidaAt          DateTime?
  createdAt        DateTime  @default(now())

  @@index([consultorioId, destinoUsuarioId, leidaAt])
  @@index([consultorioId, createdAt])
  @@map("notificaciones")
}

// ─── ASEGURADORAS (F1 + F2) ──────────────────────────────────────────────────

enum EstadoLiquidacion {
  PENDIENTE
  FACTURADO
  PAGADO
  RECHAZADO
}


model Aseguradora {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  nombre        String
  contacto      String?
  telefono      String?
  email         String?
  observaciones String?
  activa        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categorias CategoriaSeguro[]
  pacientes  Paciente[]
  liquidaciones LiquidacionItem[]

  @@index([consultorioId])
  @@map("aseguradoras")
}

model CategoriaSeguro {
  id                  Int      @id @default(autoincrement())
  consultorioId       Int
  consultorio         Consultorio @relation(fields: [consultorioId], references: [id])
  aseguradoraId       Int
  aseguradora         Aseguradora @relation(fields: [aseguradoraId], references: [id])
  nombre              String
  porcentajeCobertura Decimal  @db.Decimal(5, 2)
  activa              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tarifas TarifaCobertura[]
  pacientes Paciente[]
  citas     Cita[]
  liquidaciones LiquidacionItem[]

  @@index([consultorioId])
  @@index([aseguradoraId])
  @@map("categorias_seguro")
}

model TarifaCobertura {
  id                Int      @id @default(autoincrement())
  consultorioId     Int
  consultorio       Consultorio @relation(fields: [consultorioId], references: [id])
  categoriaSeguroId Int
  categoriaSeguro   CategoriaSeguro @relation(fields: [categoriaSeguroId], references: [id])
  servicioId        Int
  servicio          Servicio @relation(fields: [servicioId], references: [id])
  montoPaciente     Decimal  @db.Decimal(10, 2)
  montoAseguradora  Decimal  @db.Decimal(10, 2)
  activa            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([categoriaSeguroId, servicioId])
  @@index([consultorioId])
  @@map("tarifas_cobertura")
}

// Cuenta por cobrar a la aseguradora. 1 por cita con seguro. Todo snapshot:
// si el paciente cambia de seguro despues, esta fila no se toca.
model LiquidacionItem {
  id                Int      @id @default(autoincrement())
  consultorioId     Int
  consultorio       Consultorio @relation(fields: [consultorioId], references: [id])
  citaId            Int      @unique
  cita              Cita     @relation(fields: [citaId], references: [id])
  aseguradoraId     Int
  aseguradora       Aseguradora @relation(fields: [aseguradoraId], references: [id])
  categoriaSeguroId Int
  categoriaSeguro   CategoriaSeguro @relation(fields: [categoriaSeguroId], references: [id])
  pacienteId        Int
  paciente          Paciente @relation(fields: [pacienteId], references: [id])
  servicioId        Int
  servicio          Servicio @relation(fields: [servicioId], references: [id])
  fecha             DateTime
  montoAseguradora  Decimal  @db.Decimal(10, 2)
  codigoSeguro      String?
  estado            EstadoLiquidacion @default(PENDIENTE)
  facturadoAt       DateTime?
  pagadoAt          DateTime?
  rechazoMotivo     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([consultorioId, aseguradoraId, estado])
  @@index([consultorioId, fecha])
  @@map("liquidacion_items")
}

// ─── PRODUCTOS E INVENTARIO (P1) ─────────────────────────────────────────────

model Producto {
  id              Int      @id @default(autoincrement())
  consultorioId   Int
  consultorio     Consultorio @relation(fields: [consultorioId], references: [id])
  categoria       String?  // texto libre en P1
  nombre          String
  codigoBarras    String?
  precioVenta     Decimal  @db.Decimal(10, 2)
  precioCosto     Decimal  @db.Decimal(10, 2)
  stockActual     Int      @default(0)
  controlaStock   Boolean  @default(true)
  // habilitadoVenta=true => vendible (aparece en el modal de cobro / venta
  // directa). false => insumo de control interno (solo catalogo, compras P2,
  // ajustes P3).
  habilitadoVenta Boolean  @default(true)
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  detalleCobros DetalleCobro[]

  @@unique([consultorioId, codigoBarras])
  @@index([consultorioId])
  @@index([consultorioId, nombre])
  @@map("productos")
}

// Linea de detalle de un cobro: referencia un servicio O un producto (XOR; el
// CHECK vive en la migracion). precioVenta/precioCosto son snapshot al vender
// (historico para utilidad en P3). descripcion congela el nombre.
model DetalleCobro {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  cobroId       Int
  cobro         Cobro    @relation(fields: [cobroId], references: [id])
  servicioId    Int?
  servicio      Servicio? @relation(fields: [servicioId], references: [id])
  productoId    Int?
  producto      Producto? @relation(fields: [productoId], references: [id])
  descripcion   String   // snapshot del nombre (servicio o producto) al vender
  cantidad      Int      @default(1)
  precioVenta   Decimal  @db.Decimal(10, 2) // snapshot
  precioCosto   Decimal  @db.Decimal(10, 2) @default(0) // snapshot; 0 en servicios
  subtotal      Decimal  @db.Decimal(10, 2) // cantidad * precioVenta
  createdAt     DateTime @default(now())
  // Devolucion a nivel de linea (soft): la linea no se borra; devueltoAt!=null
  // la excluye de los recomputos de cobro y de los reportes de ventas.
  devueltoAt    DateTime?
  devueltoPorId Int?
  devueltoPor   Usuario?  @relation("DetalleDevueltoPor", fields: [devueltoPorId], references: [id])
  createdById   Int?
  createdBy     Usuario?  @relation("DetalleCreadoPor", fields: [createdById], references: [id])

  @@index([consultorioId])
  @@index([cobroId])
  @@index([consultorioId, productoId])
  @@map("detalle_cobros")
}
